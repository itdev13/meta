# ── Core ───────────────────────────────────────────────────────
DATABASE_URL=""
PORT=3025
BACKEND_URL="https://whatsappapi.vaultsuite.store"
FRONTEND_URL="https://whatsapp.vaultsuite.store"
# Unique per running process. Sessions are leased to ONE instance at a time so two servers
# never drive the same WhatsApp session (that gets the number logged out / "replaced").
INSTANCE_ID=""

# ── Encryption (32-byte hex: `openssl rand -hex 32`) ───────────
ENCRYPTION_KEY=""

# ── Session (SSO → JWT) ────────────────────────────────────────
JWT_SECRET=""
SESSION_TTL="43200"
# Local only: enables POST /auth/dev to mint agency/location sessions without GHL.
ALLOW_DEV_LOGIN="false"

# ── GHL app ────────────────────────────────────────────────────
GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""
GHL_REDIRECT_URI="https://whatsappapi.vaultsuite.store/auth/callback"
GHL_SSO_KEY=""
GHL_APP_ID=""
GHL_CONVERSATION_PROVIDER_ID=""
# Call-type provider ("WhatsApp Voice") — WhatsApp call history is logged under it. Empty = calls
# are logged as a text line on the messaging provider instead.
GHL_CALL_PROVIDER_ID=""
GHL_API_BASE="https://services.leadconnectorhq.com"
GHL_API_VERSION="2021-07-28"
# Message type used for the conversation provider. "Custom" (own channel) or "SMS" (if the
# provider is registered as an SMS replacement, so "Send SMS" workflow steps go out via WhatsApp).
GHL_MESSAGE_TYPE="Custom"

# ── GHL webhook signature ──────────────────────────────────────
GHL_WEBHOOK_ED25519_PUBLIC_KEY=""
GHL_WEBHOOK_LEGACY_PUBLIC_KEY=""
GHL_WEBHOOK_VERIFY_MODE="monitor"   # monitor | enforce

# ── Subscription ───────────────────────────────────────────────
SUBSCRIPTION_REQUIRED="true"
TRIAL_DAYS="3"
TRIAL_CONVERT_GRACE_DAYS="4"
# Map each GHL planId to a tier. numberLimit = WhatsApp numbers a sub-account may link.
# PLANS_JSON={"<starterPlanId>":{"name":"Starter","priceUsd":29,"numberLimit":1},"<growthPlanId>":{"name":"Growth","priceUsd":59,"numberLimit":3},"<scalePlanId>":{"name":"Scale","priceUsd":99,"numberLimit":10}}
PLANS_JSON=""
PLAN_NAME="Starter"
PLAN_PRICE_USD="29"
PLAN_NUMBER_LIMIT="1"
GHL_DEFAULT_APP_DOMAIN="app.gohighlevel.com"
GHL_APP_VERSION_ID=""
MARKETPLACE_UPGRADE_URL=""

# ── WhatsApp runtime ───────────────────────────────────────────
WA_BROWSER_NAME="Vaultsuite Connect"
WA_RESTORE_STAGGER_MS="1500"
# Max numbers handshaking at once while restoring after a restart (most recently active first).
WA_RESTORE_CONCURRENCY="5"
# A send for a number that is still reconnecting waits this long before failing.
WA_SEND_WAIT_MS="20000"
WA_MAX_QR_PER_ATTEMPT="6"
WA_MEDIA_TTL_DAYS="7"
BAILEYS_LOG_LEVEL="silent"

# ── Sending safety defaults (overridable per agency / per number) ──
WA_DEFAULT_MIN_DELAY_MS="1500"
WA_DEFAULT_DAILY_LIMIT="1000"

# ── Disconnect alerts (email) ──────────────────────────────────
# Option A — Brevo (recommended, same as ConvoVault). Sender must be verified in Brevo.
BREVO_API_KEY=""
ALERT_FROM_EMAIL="support@vaultsuite.store"
ALERT_FROM_NAME="Greenline for WhatsApp"
# Hidden copy of every alert email (comma-separated), e.g. the app owner.
ALERT_CC=""
# Option B — Gmail app password (SMTP_USER + SMTP_PASS only), or any SMTP provider (+ SMTP_HOST/PORT).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# A dropped connection alerts only if still down after this many minutes (logouts/bans alert at once).
ALERT_DISCONNECT_MINUTES="10"
# Reminder while a number stays down (max 3 reminders).
ALERT_REMINDER_HOURS="24"

# ── Misc ───────────────────────────────────────────────────────
ADMIN_API_KEY=""
DEFAULT_PHONE_COUNTRY_CODE=""
LOG_TZ="Asia/Kolkata"

# ── Proxy per number (bring your own) ──────────────────────────
# JSON object: ISO-2 country code → list of proxy URLs. Schemes: http://, https://, socks5://
# (also socks5h / socks4). A number whose settings.proxyCountry is e.g. "GB" always uses the same
# GB proxy (stable hash of its session id) for the WebSocket and media uploads. If the chosen
# country has no proxies here the number connects directly (a warning is logged). Credentials
# are masked in logs and never sent to the UI. Changes apply on the next connect / server restart.
# PROXY_POOL_JSON={"GB":["http://user:pass@gb1.proxy.example:8000"],"IN":["socks5://u:p@in1.proxy:1080"]}
PROXY_POOL_JSON=""
